---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Accordion from '../components/Accordion.astro';
import Certs from '../components/Certs.astro';
import { site } from '../data/site';
import { ui, fmt } from '../i18n/ui';
import { r, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const v = { years: site.years };
const img = (n: string) => `/assets/img/${n}`;
const originIcons = ['layers', 'sun', 'drop', 'mountain'];
const partnerIcons = ['waves', 'calendar', 'trend', 'globe'];
const d = (i: number, step = 90) => `--d:${i * step}ms`;
const ticker = [
  h.hero.eyebrow,
  `${fmt(h.years.big, v)} ${h.years.t}`,
  `${h.reach.big} ${h.reach.t}`,
  t.common.delivery,
  t.apply.perks[3],
];
---

<Base lang={lang} pageKey="home" title={h.title} description={h.description} ogImage="/assets/img/Wedding-season.webp">
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <img src={img('Wedding-season.webp')} alt={h.hero.alt} width="1920" height="1080" fetchpriority="high" decoding="async" />
      <div class="content">
        <p class="eyebrow" data-reveal style="--d:80ms">{h.hero.eyebrow}</p>
        <h1 id="hero-title" style="margin:0">
          <span class="l1" style="display:block" data-split>{h.hero.l1}</span>
          <span class="l2" style="display:block;--split-delay:420ms" data-split>{h.hero.l2}</span>
        </h1>
        <a class="btn btn-green btn-sq" href={r('varieties', lang)} data-reveal style="--d:1100ms">{h.hero.cta}</a>
      </div>
      <div class="hero-chips" data-reveal style="--d:1400ms">
        <div class="chip-stat"><b>{fmt(h.years.big, v)}</b><span>{h.years.t}</span></div>
        <div class="chip-stat"><b>{h.reach.big}</b><span>{h.reach.t}</span></div>
        <div class="chip-stat wide"><Icon name="globe" /><span>{t.common.delivery}</span></div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <ul>
            {ticker.map((x) => <li><Icon name="flower" />{x}</li>)}
          </ul>
        ))}
      </div>
    </div>

    <section class="section box story" aria-labelledby="about-label">
      <div class="story-media" data-reveal>
        <figure class="sm-arch"><img src={img('IMG_8573-1-1-scaled.webp')} alt="" loading="lazy" decoding="async" /></figure>
        <figure class="sm-dot"><img src={img('magnific_create-a-professional-pho_2919792126.webp')} alt="" loading="lazy" decoding="async" /></figure>
        <div class="sm-badge"><Icon name="flower" /><span>{h.hero.eyebrow}</span></div>
      </div>

      <div class="story-copy">
        <span class="pill" id="about-label">{h.aboutLabel}</span>
        <div class="story-tabs" role="tablist" aria-label={h.aboutLabel}>
          {h.tabs.map((tab, i) => (
            <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><i>{String(i + 1).padStart(2, '0')}</i><span>{tab.k}</span></button>
          ))}
        </div>
        <div class="story-panels">
          {h.tabs.map((tab, i) => (
            <div class="story-panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
              <p class="lead">{fmt(tab.lead, v)}</p>
              <p class="sub">{tab.sub}</p>
              <a class="btn btn-outline" href={r('about', lang)}>{t.common.learnMore} <Icon name="arrow" /></a>
            </div>
          ))}
        </div>
        <div class="story-facts">
          <div class="fact" data-reveal>
            <div class="big" data-count={site.years} data-prefix="+">{fmt(h.years.big, v)}</div>
            <div><h3>{h.years.t}</h3><p>{h.years.d}</p></div>
          </div>
          <div class="fact" data-reveal style={d(1)}>
            <div class="big" data-count="50">{h.reach.big}</div>
            <div><h3>{h.reach.t}</h3><p>{h.reach.d}</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt" aria-labelledby="altitude-title">
      <div class="alt-box" id="alt" data-reveal>
        <div class="alt-media">
          <img src={img('5-2.webp')} alt={h.altitude.alt} loading="lazy" decoding="async" />
          <div class="alt-title">
            <h2 id="altitude-title">
              <span style="display:block" data-split>{h.altitude.l1}</span>
              <span style="display:block;--split-delay:260ms" data-split>{h.altitude.l2}</span>
            </h2>
            <a class="btn btn-outline-light alt-cta" href={r('varieties', lang)}>{h.altitude.cta}</a>
          </div>
          <div class="alt-dock">
            <p class="alt-hint">{h.altitude.hint}</p>
            <div class="alt-icons" role="tablist" aria-label={h.altitude.l1 + ' ' + h.altitude.l2}>
              {h.origin.map((o, i) => (
                <button type="button" role="tab" id={`alt-tab-${i}`} aria-controls={`alt-panel-${i}`} aria-selected="false" tabindex={i === 0 ? 0 : -1} title={o.t}>
                  <span class="icon-circle"><Icon name={originIcons[i]} /></span>
                  <span class="alt-name">{o.t}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
        <div class="alt-side">
          <div class="alt-frame">
            <button class="alt-close" type="button" aria-label={t.nav.close}><Icon name="close" /></button>
            <div class="alt-panels">
              {h.origin.map((o, i) => (
                <article class="alt-panel" role="tabpanel" id={`alt-panel-${i}`} aria-labelledby={`alt-tab-${i}`} hidden>
                  <span class="alt-num">{String(i + 1).padStart(2, '0')} / {String(h.origin.length).padStart(2, '0')}</span>
                  <span class="icon-circle big"><Icon name={originIcons[i]} /></span>
                  <h3>{o.t}</h3>
                  <p>{o.d}</p>
                </article>
              ))}
            </div>
            <div class="alt-foot">
              <div class="alt-nav">
                <button type="button" class="alt-prev" aria-label="←"><Icon name="arrow" /></button>
                <button type="button" class="alt-next" aria-label="→"><Icon name="arrow" /></button>
              </div>
              <a class="btn btn-green" href={r('varieties', lang)}>{h.altitude.cta} <Icon name="arrow" /></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section partners partners-light" aria-labelledby="partners-title">
      <div class="partners-head">
        <h2 id="partners-title" data-split>{h.partners.title}</h2>
        <p class="sub" data-reveal style="--d:200ms">{h.partners.sub}</p>
      </div>
      <div class="partners-body">
        <figure class="partner-photo" data-reveal>
          <img src={img('IMG_8585-1.webp')} alt={h.partners.photoAlt} loading="lazy" decoding="async" />
          <figcaption class="partner-chip">
            <b>{fmt(h.years.big, v)}</b>
            <span>{h.years.t}</span>
          </figcaption>
        </figure>
        <div class="partner-grid">
          {h.partners.items.map((p, i) => (
            <article class="partner-card" data-reveal style={d(i)}>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon-circle"><Icon name={partnerIcons[i]} /></span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Certs lang={lang} />

    <section class="section faq-block" aria-labelledby="faq-title">
      <div class="faq-card" data-reveal>
        <p class="label">{h.faq.label}</p>
        <h2 id="faq-title" data-split>{h.faq.title}</h2>
        <p class="intro">{h.faq.intro}</p>
        <Accordion items={h.faq.items} />
        <p style="margin:26px 0 0"><a class="btn btn-outline-light" href={r('contact', lang)}>{h.faq.cta} <Icon name="arrow" /></a></p>
      </div>
      <div class="faq-photo" data-reveal style="--d:120ms">
        <img src={img('32917.webp')} alt={h.faq.photoAlt} loading="lazy" decoding="async" />
        <div class="glass">
          <h3>{h.faq.glass.t}</h3>
          <p>{h.faq.glass.d}</p>
          <a class="btn btn-outline-light" href={r('about', lang)}>{t.common.learnMore} <Icon name="arrow" /></a>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Story tabs (arrow keys, Home/End).
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.story-tabs [role=tab]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((tab, n) => {
        const on = n === i;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
        if (on && focus) tab.focus();
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
        if (e.key === 'Home') { e.preventDefault(); select(0, true); }
        if (e.key === 'End') { e.preventDefault(); select(tabs.length - 1, true); }
      });
    });
  </script>
  <script>
    // Altitude banner: tap an icon and the photo slides to the left half while a frame with the text opens
    // on the right. The icons keep working as buttons to switch topics; tapping the active one (or the X) closes it.
    const alt = document.getElementById('alt');
    if (alt) {
      const icons = Array.from(alt.querySelectorAll<HTMLButtonElement>('.alt-icons [role=tab]'));
      const panels = Array.from(alt.querySelectorAll<HTMLElement>('.alt-panel'));
      let cur = -1;
      const show = (i: number, focus = false) => {
        cur = i;
        alt.classList.toggle('open', i >= 0);
        icons.forEach((b, n) => {
          b.setAttribute('aria-selected', String(n === i));
          b.tabIndex = n === i || (i < 0 && n === 0) ? 0 : -1;
        });
        panels.forEach((p, n) => (p.hidden = n !== i));
        if (i >= 0 && focus) icons[i].focus();
      };
      icons.forEach((b, i) => {
        b.addEventListener('click', () => show(cur === i ? -1 : i));
        b.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); show((Math.max(cur, 0) + (cur < 0 ? 0 : 1)) % icons.length, true); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); show((Math.max(cur, 0) - 1 + icons.length) % icons.length, true); }
          if (e.key === 'Escape') { show(-1); b.focus(); }
        });
      });
      alt.querySelector('.alt-close')!.addEventListener('click', () => { show(-1); icons[0].focus(); });
      alt.querySelector('.alt-next')!.addEventListener('click', () => show((cur + 1) % icons.length));
      alt.querySelector('.alt-prev')!.addEventListener('click', () => show((cur - 1 + icons.length) % icons.length));
    }
  </script>
</Base>
