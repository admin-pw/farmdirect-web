---
import Icon from './Icon.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Cover photos are flowers from our own library (not people). Add a real customer photo later
// by giving a review a `photo` path in ui.ts.
const covers = ['freepik_a-closeup-shallow-depthof_2844339269-1.webp', 'Spray-Roses.webp'];
const initials = (n: string) => n.trim().slice(0, 1).toUpperCase();
---

<div class="review-grid">
  {
    ui[lang].reviews.map((q, i) => (
      <figure class="review" data-reveal style={`--d:${i * 120}ms`}>
        <div class="review-cover"><img src={`/assets/img/${covers[i % covers.length]}`} alt="" loading="lazy" decoding="async" /></div>
        <div class="review-body">
          <Icon name="quote" class="qicon" />
          <blockquote>{q.q}</blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{initials(q.n)}</span>
            <span>
              <b>{q.n}</b>
              <span class="where"><Icon name="pin" />{q.p}</span>
            </span>
          </figcaption>
        </div>
      </figure>
    ))
  }
</div>
